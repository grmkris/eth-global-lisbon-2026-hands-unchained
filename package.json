{
  "name": "proof-of-hands",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "check": "bun run --cwd apps/web check",
    "typecheck": "cd apps/web && bunx tsc --noEmit",
    "hub": "bun run --cwd apps/web hub",
    "hub:prod": "bun run --cwd apps/web hub:prod",
    "agent": "bun run --cwd apps/web agent",
    "rig:sim": "bun run --cwd apps/web rig:sim",
    "rig:sim:cloud": "bun run --cwd apps/web rig:sim:cloud",
    "rig:real": "bun run --cwd apps/web rig:real",
    "rig:real:cloud": "bun run --cwd apps/web rig:real:cloud",
    "teleop": "bun run --cwd apps/web teleop",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test",
    "contracts:abi": "cd contracts && forge build && cd .. && bun apps/web/scripts/sync-abi.ts",
    "driver:sync": "cd apps/driver && uv sync",
    "driver:ast": "cd apps/driver && for f in *.py backends/*.py sources/*.py; do .venv/bin/python -c \"import ast; ast.parse(open('$f').read())\" || echo FAIL $f; done"
  }
}